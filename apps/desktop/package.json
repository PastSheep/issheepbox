{
  "name": "@issheepbox/desktop",
  "version": "0.2.1",
  "description": "Is Sheep Box Electron 宿主入口",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/PastSheep/issheepbox.git"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build && electron dist/main.js",
    "clean": "tsc --build --clean",
    "pack": "tsc --build && electron-builder --win --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@issheepbox/kernel": "workspace:*",
    "@issheepbox/market-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  }
}
